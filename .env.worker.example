# Copia a .env.worker (el archivo nunca debe contener tokens en Git).
# El medio puede estar en disco externo, copia sincronizada o montaje de red.
WORKER_MEDIA_DIR=./media
WORKER_CATALOG_FILE=./apps/player/suno-library-enriched.json
# Entrada alternativa: enlaces que el usuario manda por chat o añade al inbox local.
WORKER_SUNO_LINKS_FILE=./inbox/suno-links.json
WORKER_SOURCE_AUDIO_PREFIX=/Volumes/ADATA SC740/MÚSICA/WAV_MASTER
WORKER_INTERVAL_SECONDS=60
WORKER_BATCH_SIZE=500
