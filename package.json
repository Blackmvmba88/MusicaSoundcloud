{
  "name": "blackmamba-music-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reproductor, catalogo local y automatizacion de portadas para SoundCloud.",
  "scripts": {
    "dev": "node --watch apps/server/src/server.mjs",
    "start": "node apps/server/src/server.mjs",
    "db:init": "node scripts/init-db.mjs",
    "doctor": "node scripts/doctor.mjs",
    "soundcloud:authorize": "node scripts/authorize-soundcloud.mjs",
    "soundcloud:audit": "node scripts/audit-soundcloud.mjs",
    "soundcloud:match-suno": "node scripts/build-soundcloud-suno-match.mjs",
    "artwork:dry-run": "node automations/artwork-sync.mjs --dry-run",
    "test": "node --test",
    "usb:consolidate-wav": "node scripts/consolidate-usb-wav.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
